src/application/use-cases/admin/

├── appointments/
│   ├── list-all-appointments.use-case.ts      (todos os agendamentos, filtrado por período)
│   ├── get-appointment.use-case.ts            (detalhe de qualquer agendamento)
│   └── cancel-appointment.use-case.ts         (cancelar agendamento de qualquer um)
│
├── users/
│   ├── list-users.use-case.ts                 (listar todos usuários com filtros: role, search)
│   ├── get-user.use-case.ts                   (detalhe de um usuário)
│   └── change-user-role.use-case.ts           (promover customer → barber, barber → admin, etc)
│
├── services/
│   ├── list-services.use-case.ts              (listar TODOS, ativos + inativos)
│   ├── get-service.use-case.ts                (detalhe de um serviço)
│   ├── create-service.use-case.ts             (criar novo serviço)
│   ├── update-service.use-case.ts             (editar serviço)
│   └── delete-service.use-case.ts             (soft delete)
│
└── reports/
    ├── get-summary-report.use-case.ts         (resumo geral: total agendamentos, receita, clientes)
    ├── get-barber-performance.use-case.ts     (por barbeiro: agendamentos, receita, rating)
    └── get-revenue-report.use-case.ts         (receita por período, por barbeiro, por serviço)




